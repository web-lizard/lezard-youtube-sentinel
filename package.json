{
  "name": "lizard-youtube-sentinel",
  "version": "0.1.0",
  "description": "Firefox WebExtension for safe, AI-assisted YouTube comment workflows",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/web-lizard/lezard-youtube-sentinel.git"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "npm run check && node scripts/build.mjs",
    "check": "npm run typecheck && npm test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vitest": "^5.0.3"
  }
}
